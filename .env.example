# Переменные для docker-compose. Скопировать в .env: cp .env.example .env
# Сгенерировать секреты: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-another-strong-random-secret"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mitso_db

# Необязательно. Мониторинг ошибок Sentry выключен, пока SENTRY_DSN пуст.
# LOG_LEVEL: debug | info | warn | error (по умолчанию debug локально, info в проде)
SENTRY_DSN=
# Фронтенд (отдельный проект Sentry типа Vue/Browser), задаётся в окружении фронта: NUXT_PUBLIC_SENTRY_DSN
# LOG_LEVEL=debug

# Необязательно. Кэш справочников: Redis, если задан REDIS_URL, иначе память процесса.
# В docker compose backend уже получает REDIS_URL=redis://redis:6379.
# Локально без Docker-backend: REDIS_URL=redis://localhost:6379 (в backend/.env) после `docker compose up -d redis`
# REDIS_URL=

# Только для docker-compose.prod.yml (docker compose -f docker-compose.prod.yml up -d --build)
# FRONTEND_URL=https://app.example.com
# API_PUBLIC_URL=https://api.example.com/api
