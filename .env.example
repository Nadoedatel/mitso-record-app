# Переменные для docker-compose. Скопировать в .env: cp .env.example .env
# Сгенерировать секреты: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-another-strong-random-secret"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mitso_db

# Необязательно. Мониторинг ошибок Sentry выключен, пока SENTRY_DSN пуст.
# LOG_LEVEL: debug | info | warn | error (по умолчанию debug локально, info в проде)
SENTRY_DSN=
# Фронтенд (отдельный проект Sentry типа Vue/Browser), задаётся в окружении фронта: NUXT_PUBLIC_SENTRY_DSN
# LOG_LEVEL=debug

# Необязательно. Кэш справочников: Redis, если задан REDIS_URL, иначе память процесса.
# Фоновые задачи (экспорт зачётки в Excel, импорт студентов из CSV) работают ТОЛЬКО с Redis: без REDIS_URL эндпоинты /api/jobs отвечают 503.
# В docker compose backend уже получает REDIS_URL=redis://redis:6379.
# Локально без Docker-backend: REDIS_URL=redis://localhost:6379 (в backend/.env) после `docker compose up -d redis`
# REDIS_URL=

# Необязательно. Двухфакторный вход админа (приложение-аутентификатор). Без ключа функция выключена, остальное работает.
# Ключ шифрует секреты TOTP в базе: 32 случайных байта в base64. Сменить ключ = все секреты станут нечитаемыми (2FA придётся включать заново).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOTP_ENCRYPTION_KEY=

# Необязательно. Метрики Prometheus: GET /api/metrics с заголовком `Authorization: Bearer <METRICS_TOKEN>`.
# Без токена эндпоинта нет (404): метрики показывают внутренности и закрыты по умолчанию.
# METRICS_TOKEN=

# Необязательно. Общий лимит запросов в минуту с одного IP (по умолчанию 60). Поднимать ТОЛЬКО для нагрузочного теста (npm run load:backend делает это сам).
# RATE_LIMIT_PER_MINUTE=

# Только для docker-compose.prod.yml (docker compose -f docker-compose.prod.yml up -d --build)
# FRONTEND_URL=https://app.example.com
# API_PUBLIC_URL=https://api.example.com/api
