{
  "name": "mitso-record-app-frontend",
  "version": "1.0.0",
  "description": "MITSO Record",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "api:types": "openapi-typescript ../backend/openapi.json -o app/shared/api/generated/schema.d.ts",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"app/**/*.{vue,scss}\"",
    "format": "prettier --write \"app/**/*.{ts,vue,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run lint:style && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@pinia/nuxt": "^1.0.2",
    "@sentry/vue": "^11.4.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.6.0",
    "pinia": "^4.0.3",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.30",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
