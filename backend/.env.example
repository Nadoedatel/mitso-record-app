# Совпадает с postgres из docker-compose (npm run db в корне)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mitso_db"

# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-another-strong-random-secret"

FRONTEND_URL=http://localhost:3000
# Сколько прокси стоит перед бэкендом (Render: 1). Пусто = прокси нет, X-Forwarded-For игнорируется. "true" запрещено.
TRUST_PROXY=
PORT=8080
