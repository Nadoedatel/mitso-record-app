// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student  Student?
  teacher  Teacher?
  sessions RefreshSession[]

  @@map("users")
}

/// One row per issued refresh token. Rows of one login (one device) share familyId;
/// usedAt is set when the token is rotated, so a second use of it reveals a stolen copy.
model RefreshSession {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model Student {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique @map("user_id")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  middleName       String?   @map("middle_name")
  studentId        String    @unique @map("student_id") // Номер зачетной книжки
  groupId          Int?      @map("group_id")
  course           Int
  specializationId Int?      @map("specialization_id")
  enrollmentYear   Int       @map("enrollment_year")
  phone            String?
  address          String?
  birthDate        DateTime? @map("birth_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group          Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  specialization Specialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  grades         Grade[]

  // Group roster and the FK action on deleting a group. Measured on 20k students: 1.3 ms -> 0.25 ms.
  @@index([groupId])
  @@map("students")
}

model Teacher {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  middleName     String?  @map("middle_name")
  department     String
  position       String
  academicDegree String?  @map("academic_degree")
  phone          String?
  officeNumber   String?  @map("office_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
  grades          Grade[]

  @@map("teachers")
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  credits     Int
  semester    Int
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacherSubjects TeacherSubject[]
  subjectGroups   SubjectGroup[]
  grades          Grade[]

  @@map("subjects")
}

model Grade {
  id         Int       @id @default(autoincrement())
  studentId  Int       @map("student_id")
  subjectId  Int       @map("subject_id")
  teacherId  Int?      @map("teacher_id")
  gradeValue Int       @map("grade_value") // 1-10; для CREDIT: 1 = зачёт, 0 = не зачёт (см. grades/grade-rules.ts)
  gradeType  GradeType @map("grade_type")
  examDate   DateTime? @map("exam_date")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, gradeType])
  // Grades of one subject, newest first (grade lists, pagination) and the FK action on deleting a subject.
  // Measured on 500k rows: 9.9 ms -> 0.12 ms for the list, 16.5 ms -> 3.6 ms for deleting a subject.
  @@index([subjectId, examDate(sort: Desc)])
  @@map("grades")
}

enum GradeType {
  EXAM // Экзамен
  CREDIT // Зачёт
  COURSEWORK // Курсовая работа
  TEST // Контрольная работа
  LAB // Лабораторная работа
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  course    Int
  facultyId Int?     @map("faculty_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculty       Faculty?       @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  students      Student[]
  subjectGroups SubjectGroup[]

  @@map("groups")
}

model TeacherSubject {
  id        Int      @id @default(autoincrement())
  teacherId Int      @map("teacher_id")
  subjectId Int      @map("subject_id")
  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

model SubjectGroup {
  id        Int      @id @default(autoincrement())
  subjectId Int      @map("subject_id")
  groupId   Int      @map("group_id")
  createdAt DateTime @default(now()) @map("created_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([subjectId, groupId])
  @@map("subject_groups")
}

model Faculty {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  specializations Specialization[]
  groups          Group[]

  @@map("faculties")
}

model Specialization {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?
  facultyId Int      @map("faculty_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculty  Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([name, facultyId])
  @@map("specializations")
}
